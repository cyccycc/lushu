# Copy to .env at the repo root. Never commit the real file.
# The web app and `pnpm eval:live` read this file. `pnpm eval` stays offline.

# --- Model (OpenAI-compatible). ---
# The new roadbook UI does NOT read this. Put the key in the browser
# (首页「填写模型密钥」). It is sent per request and never stored or logged.
# LLM_API_KEY is only for the legacy two-plan flow and `pnpm eval:live`.
# Also accepts XAI_API_KEY if LLM_API_KEY is unset.
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7

# Optional. Leave this unset unless you intentionally want to send reasoning_effort.
# DeepSeek should omit the parameter. `low` can make DeepSeek return empty patches.
# Other providers still default to low when this is unset.
# LLM_REASONING_EFFORT=

# Per-request timeout. Reasoning models can be slow.
LLM_TIMEOUT_MS=120000

# Used only to enforce the session cost cap. Not an invoice.
# Defaults match public grok-4.7 short-context rates (USD per 1M tokens).
LLM_PRICE_INPUT_PER_MTOK=2
LLM_PRICE_OUTPUT_PER_MTOK=6

# --- Session hard limits ---
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_COST_USD=0.5

# --- Web search (optional). Without a key, search stubs and says so. ---
# SEARCH_PROVIDER=auto|tavily|brave|stub
# SEARCH_API_KEY is a Tavily key, unless SEARCH_PROVIDER=brave.
# Or set TAVILY_API_KEY / BRAVE_SEARCH_API_KEY on their own.
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# Weather uses Open-Meteo and needs no key.
# If the network is blocked, weather stubs and the plan says the forecast is unavailable.

# --- Roadbook access (set both before a reachable deploy) ---
# Single shared password. Empty = local dev, reads still need the secret link,
# and the server will not list every roadbook.
ACCESS_PASSWORD=

# --- Email login (legacy sessions only). No phone number, no payment. ---
# AUTH_SECRET also signs the roadbook password cookie.
# AUTH_SECRET signs the session cookie. If it is empty, the server writes
# data/auth/dev-secret on first use. Set a long random value before sharing the machine.
AUTH_SECRET=
# SMTP is optional. With SMTP_HOST empty, the 6-digit code is printed in the
# server log and is not returned to the browser.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=路书 <noreply@localhost>
